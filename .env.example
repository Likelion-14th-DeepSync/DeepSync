MYSQL_DATABASE=deepsync
MYSQL_USER=deepsync
MYSQL_PASSWORD=deepsync
MYSQL_ROOT_PASSWORD=deepsync-root
MYSQL_PORT=3307

# Set these when running the backend with non-default database credentials.
DB_URL=jdbc:mysql://localhost:3307/deepsync?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=deepsync
DB_PASSWORD=deepsync

# Use a securely generated value with at least 32 bytes outside local development.
JWT_SECRET=replace-with-a-secure-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
